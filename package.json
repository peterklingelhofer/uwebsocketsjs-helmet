{
  "name": "uwebsocketsjs-helmet",
  "version": "0.1.0",
  "description": "A zero-dependency security headers middleware for uWebSockets.js, similar to Helmet for Express and @fastify/helmet for Fastify",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "uwebsockets",
    "uwebsockets.js",
    "helmet",
    "security",
    "headers",
    "csp",
    "middleware",
    "hsts"
  ],
  "author": "Peter Klingelhofer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterklingelhofer/uwebsocketsjs-helmet.git"
  },
  "bugs": {
    "url": "https://github.com/peterklingelhofer/uwebsocketsjs-helmet/issues"
  },
  "homepage": "https://github.com/peterklingelhofer/uwebsocketsjs-helmet#readme",
  "peerDependencies": {
    "uWebSockets.js": "^20.0.0 || ^21.0.0"
  },
  "peerDependenciesMeta": {
    "uWebSockets.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.68.0",
    "vitest": "^4.1.7"
  }
}
